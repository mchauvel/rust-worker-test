# Backend used to receive tasks: rabbitmq or elasticsearch.
TASK_BACKEND=rabbitmq

# Common application settings (used with either backend).
HTTP_ADDR=127.0.0.1:8080
WORKER_CONCURRENCY=4
HELM_BIN=/usr/local/bin/helm
HELM_TIMEOUT_SECS=600
RUST_LOG=info

# RabbitMQ settings. Used only when TASK_BACKEND=rabbitmq.
AMQP_ADDR=amqp://127.0.0.1:5672/%2f
AMQP_QUEUE=tasks

# Elasticsearch settings. Used only when TASK_BACKEND=elasticsearch.
# Set ES_URL and choose either ES_API_KEY or both ES_USERNAME and ES_PASSWORD.
# ES_URL=https://elasticsearch.example.com:9200
# ES_TASK_INDEX=tasks
# ES_API_KEY=
# ES_USERNAME=
# ES_PASSWORD=
# ES_TASK_LEASE_SECS=900
# ES_MAX_ATTEMPTS=5
# ES_RETRY_DELAY_SECS=5
